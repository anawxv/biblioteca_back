# Modo local direto (sem proxy):
# VITE_API_URL=http://localhost:8080/api
#
# Modo ngrok tunel unico (recomendado free) — proxy Vite encaminha /api -> :8080:
VITE_API_URL=/api
#
# Modo ngrok dois tuneis — URL publica do backend:
# VITE_API_URL=https://SEU-BACKEND.ngrok-free.app/api
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID_AQUI
